---
import { Icon } from "astro-icon/components";
---

<div id="users-view" class="tab-content hidden space-y-6">
  <!-- 顶部操作栏 -->
  <div class="flex items-center justify-between">
    <div>
      <h3 class="text-xl font-bold text-gray-800 dark:text-white">管理员列表</h3>
      <p class="text-sm text-gray-400 mt-1">管理后台协作成员</p>
    </div>
      <div class="flex gap-3">
        <button id="change-pwd-btn" class="flex items-center gap-2 px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-xl hover:bg-gray-100 dark:hover:bg-gray-800 transition text-sm text-gray-700 dark:text-gray-200">
            <Icon name="material-symbols:lock-outline" /> 修改密码
        </button>
        <button id="add-admin-btn" class="flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-xl transition text-sm font-medium shadow-md" style="display:none">
            <Icon name="material-symbols:person-add-outline" /> 添加管理员
        </button>
    </div>
  </div>

  <!-- 用户列表 -->
  <div class="bg-white dark:bg-[#25262b] rounded-2xl shadow-sm border border-gray-100 dark:border-gray-800 overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-gray-100 dark:border-gray-800 bg-gray-50 dark:bg-gray-800/50">
          <th class="text-left p-4 font-medium text-gray-500">用户</th>
          <th class="text-left p-4 font-medium text-gray-500 hidden md:table-cell">角色</th>
          <th class="text-left p-4 font-medium text-gray-500 hidden md:table-cell">联系方式</th>
          <th class="text-right p-4 font-medium text-gray-500">操作</th>
        </tr>
      </thead>
      <tbody id="users-list-body">
        <tr><td colspan="4" class="p-8 text-center text-gray-400">加载中...</td></tr>
      </tbody>
    </table>
  </div>

  <!-- ========== 添加管理员对话框 ========== -->
  <dialog id="add-admin-dialog" class="rounded-2xl shadow-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-[#25262b] p-0 w-full max-w-md backdrop:bg-black/50">
    <div class="p-6">
      <h4 class="text-lg font-bold mb-4">添加管理员</h4>
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium mb-1 opacity-60">用户名 <span class="text-red-400">*</span></label>
          <input type="text" id="new-admin-username" class="w-full px-3 py-2 rounded-lg border dark:bg-gray-800 dark:border-gray-700 outline-none" placeholder="登录用户名" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1 opacity-60">密码 <span class="text-red-400">*</span></label>
          <input type="password" id="new-admin-password" class="w-full px-3 py-2 rounded-lg border dark:bg-gray-800 dark:border-gray-700 outline-none" placeholder="至少6位" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1 opacity-60">QQ（可选，用于头像）</label>
          <input type="text" id="new-admin-qq" class="w-full px-3 py-2 rounded-lg border dark:bg-gray-800 dark:border-gray-700 outline-none" placeholder="选填" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1 opacity-60">手机号（可选）</label>
          <input type="text" id="new-admin-phone" class="w-full px-3 py-2 rounded-lg border dark:bg-gray-800 dark:border-gray-700 outline-none" placeholder="选填" />
        </div>
      </div>
      <div class="flex justify-end gap-3 mt-6">
        <button id="cancel-add-admin" class="px-4 py-2 border rounded-xl hover:bg-gray-50 dark:hover:bg-gray-800 transition text-sm">取消</button>
        <button id="confirm-add-admin" class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl transition text-sm font-medium">确认添加</button>
      </div>
    </div>
  </dialog>

  <!-- ========== 修改密码对话框 ========== -->
  <dialog id="change-pwd-dialog" class="rounded-2xl shadow-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-[#25262b] p-0 w-full max-w-md backdrop:bg-black/50">
    <div class="p-6">
      <h4 class="text-lg font-bold mb-4">修改密码</h4>
      <div class="space-y-4">
        <div>
          <label class="block text-sm font-medium mb-1 opacity-60">旧密码</label>
          <input type="password" id="old-password" class="w-full px-3 py-2 rounded-lg border dark:bg-gray-800 dark:border-gray-700 outline-none" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1 opacity-60">新密码</label>
          <input type="password" id="new-password" class="w-full px-3 py-2 rounded-lg border dark:bg-gray-800 dark:border-gray-700 outline-none" placeholder="至少6位" />
        </div>
      </div>
      <div class="flex justify-end gap-3 mt-6">
        <button id="cancel-change-pwd" class="px-4 py-2 border rounded-xl hover:bg-gray-50 dark:hover:bg-gray-800 transition text-sm">取消</button>
        <button id="confirm-change-pwd" class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-xl transition text-sm font-medium">确认修改</button>
      </div>
    </div>
  </dialog>
</div>
